{
  "name": "alisina-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alisina Sarwari — engineering and product portfolio",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run check:content && npm run check:writing && npm run check:locales && next build",
    "start": "next start --hostname 0.0.0.0",
    "check:content": "node scripts/check-content.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "smoke:http": "node scripts/smoke-http.mjs",
    "check:release": "node scripts/check-launch.mjs --strict && node scripts/check-content.mjs --release",
    "test": "node scripts/render-preview.mjs && node scripts/render-catalog-preview.mjs && node scripts/render-identity-preview.mjs && node --test tests/*.test.mjs",
    "verify": "npm run check:content && npm run check:seo && npm run check:writing && npm run check:locales && npm run check:launch && npm run test && npm run build",
    "check:launch": "node scripts/check-launch.mjs",
    "check:launch:strict": "node scripts/check-launch.mjs --strict",
    "check:links": "node scripts/verify-public-links.mjs",
    "smoke:deployed": "node scripts/smoke-deployed.mjs",
    "check:writing": "node scripts/check-writing.mjs",
    "check:phase08": "node --test tests/phase08-security.test.mjs",
    "backup:content": "node scripts/export-content-backup.mjs",
    "check:locales": "node scripts/check-locales.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
