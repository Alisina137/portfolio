# Exact owner-approved production HTTPS origin, with no path (e.g. https://YOUR-ACTUAL-DOMAIN).
# Leave empty in local development. Avoid real addresses and secrets in Git.
NEXT_PUBLIC_SITE_URL=

# Never enable until P05 human sign-off, actual contact/content approval, and
# content/launch-approval.json completed with the matching real origin.
# Non-production previews must remain false and noindex.
PORTFOLIO_LAUNCH_APPROVED=false

# Optional for the read-only deployed smoke script (never needed for normal Next app):
# PORTFOLIO_DEPLOYED_URL=https://YOUR-ACTUAL-DOMAIN
# PORTFOLIO_SMOKE_MODE=preview

# ── Phase 08: optional OWNER-ONLY Studio. Disabled unless every mandatory key is set.
# Never put any of these server-only keys under NEXT_PUBLIC_.
# Configure a GitHub OAuth App callback exactly: https://YOUR-DOMAIN/api/studio/auth/callback
# GitHub fine-grained token: Alisina137/portfolio ONLY, Contents read/write, Pull requests read/write.
PORTFOLIO_STUDIO_ENABLED=false
PORTFOLIO_GITHUB_CLIENT_ID=
PORTFOLIO_GITHUB_CLIENT_SECRET=
PORTFOLIO_OWNER_GITHUB_ID=
PORTFOLIO_STUDIO_SESSION_SECRET=
PORTFOLIO_STUDIO_GITHUB_TOKEN=
PORTFOLIO_STUDIO_REPOSITORY=Alisina137/portfolio

# ── Phase 08: optional CONTACT FORM. Disabled by default, requires every provider.
# Sender must be verified at the mail provider; do not enable without delivery and privacy review.
PORTFOLIO_CONTACT_ENABLED=false
PORTFOLIO_CONTACT_TO=
PORTFOLIO_CONTACT_FROM=
PORTFOLIO_RESEND_API_KEY=
# Cloudflare Turnstile: site key is public; verification secret stays private.
NEXT_PUBLIC_PORTFOLIO_TURNSTILE_SITE_KEY=
PORTFOLIO_TURNSTILE_SECRET=
# Upstash Redis REST: durable atomic, fail-closed rate limiting (no messages stored).
PORTFOLIO_UPSTASH_REDIS_REST_URL=
PORTFOLIO_UPSTASH_REDIS_REST_TOKEN=

# P07: developer preview ONLY; cannot enable public indexing or owner approval.
# To inspect translated pages on localhost: PORTFOLIO_LOCALE_PREVIEW=true
PORTFOLIO_LOCALE_PREVIEW=false
