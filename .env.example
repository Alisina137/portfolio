# Exact approved origin, without trailing path (for example https://your-domain.example).
# Leave empty during local development; unconfigured origins never become canonical URLs.
NEXT_PUBLIC_SITE_URL=

# Keep false until Phase 5 sign-off of contact, biography, case studies, and public media.
# The app additionally checks the approval flags in content, so this is not a bypass.
PORTFOLIO_LAUNCH_APPROVED=false
